# Example environment variables for NanoCord
# Copy this file to .env and fill in your values

# Discord Bot Token (required for exporting chat logs)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Path to DiscordChatExporter executable (optional - will be auto-detected if not set)
DISCORD_CHAT_EXPORTER_PATH="/path/to/DiscordChatExporter.Cli.exe"

# Data directory paths (these are set automatically by the app)
# RAW_DATA_DIR="data/raw/discordchat_export/"
# PROCESSED_DATA_DIR="data/processed/"

# Logging level (optional)
LOG_LEVEL="INFO"